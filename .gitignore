# AQ Poster Engine — code + brain + reference data only.
# Rendered output (out/) and scratch working images are LOCAL WORK PRODUCT, not engine source.
# Every PNG here is regenerable from the code + the composition notes in brain/RECREATION_AUDIT.md.

# All generated posters — fresh generations (Workflow A) and recreation iterations (Workflow B)
out/

# Scratchpad: keep the bespoke build SCRIPTS (the actual "how it was built" record),
# drop their rendered/source image outputs and debug dumps.
scratchpad/*.png
scratchpad/*.jpg
scratchpad/*.jpeg
scratchpad/*.pdf
scratchpad/carousel_sunderbans8/
scratchpad/events_photos/
# carousel_2026: keep build_carousel.py / jobs.py / fill_images.py (the build record), drop every
# image. These are real photographs of identifiable children from AQ workshops and this repo is
# PUBLIC — source photos and contact sheets must never be pushed. Same intent as the
# carousel_sunderbans8 exclusion above, expressed per-file so the scripts survive.
scratchpad/carousel_2026/**/src_images/
scratchpad/carousel_2026/**/*.jpg
scratchpad/carousel_2026/**/*.jpeg
scratchpad/carousel_2026/**/*.png
scratchpad/carousel_2026/*.jpg
scratchpad/format_test/
scratchpad/proof/
scratchpad/vision_debug/
scratchpad/yearbook/
scratchpad/yearbook_src/

# Python / OS / editor noise
__pycache__/
*.pyc
.DS_Store
Thumbs.db
desktop.ini

# Obsidian vault workspace state (not part of the note content)
AQ Design Engine/.obsidian/workspace*.json

# Real event photos supplied by the user: kept out of the repo (personal images, incl. minors). Regenerable from the zip.
engine/assets/terrathon/throwback_cricket/
engine/assets/terrathon/promo_photos/*/*.jpg
engine/assets/terrathon/day_photos/*.jpg
scratchpad/cricket_web/
scratchpad/cricket_zip/

# TerraThon carousel photos: real people at events, PUBLIC repo. Regenerate from the source zips with scratchpad/tt_reasons8_prep.py
engine/assets/terrathon/carousel_photos/
engine/assets/terrathon/recap_photos/

# REVER deck: local renders and working images contain real guest photos (public repo)
scratchpad/rever_deck_out/
scratchpad/work/

# Sponsorship / stalls decks + brochures (2026-10-09). The source export and everything extracted from it contain
# identifiable school children, third-party partner logos and a named contact's phone number, and this repo is PUBLIC.
# The code that builds the decks is committed; the data is not. Regenerate assets with scratchpad/deck_assets.py
# from a copy of the source PDF placed at training_samples/sponsorship_deck/source_export.pdf.
engine/assets/sponsorship/
training_samples/sponsorship_deck/
scratchpad/sponsorship_private/
